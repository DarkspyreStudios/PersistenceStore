<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Darkspyre.Persist</PackageId>
    <AssemblyName>Darkspyre.Persist</AssemblyName>
    <RootNamespace>Darkspyre.Persist</RootNamespace>
    <Description>Storage-neutral blob persistence for .NET, with an atomic filesystem provider rooted in the operating system's per-user application-data directory.</Description>
    <PackageTags>persistence;storage;blob;filesystem;application-data</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
